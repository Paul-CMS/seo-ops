      "plain": "an outcome for every audit step",
      "producer": "/discovery {slug} audit"
    },
    "pages_built": {
      "label": "Every page in the site plan is built, verified and written back",
      "plain": "every page built and written back",
      "requires": [
        "discovery_signed_off"
      ]
    },
    "wordpress_connected": {
      "label": "WordPress connected (/wp-check passed in the last 30 days)",
      "plain": "a working WordPress connection",
      "producer": "/wp-check {slug}"
    },
    "discovery_signed_off": {
      "label": "Discovery and audit signed off — Build may start (met when the Decision Sheet, entity, client facts, audit and Brand Guide are approved and the client's facts are recorded)",
      "plain": "the discovery sign-off (the two discovery approvals and the client's facts)",
      "requires": [
        "entity_approved",
        "proof_sheet_approved",
        "proof_sheet_returned",
        "audit_approved",
        "brand_guide_approved"
      ],
      "derived": true
    },
    "blockers_cleared": {
      "label": "Technical blockers cleared — every blocker handoff returned done and /verify passed it",
      "plain": "the technical blockers cleared (Jonie's handoff done and verified)",
      "requires": [
        "discovery_signed_off"
      ],
      "producer": "/build {slug} blockers",
      "wait_for": "Jonie to return the technical blocker handoff (then /verify checks it)"
    },
    "page_specs_approved": {
      "label": "Page specs approved by Paul once, globally (methodology/specs) and unchanged since",
      "plain": "the page specs (approved once, for every client)",
      "global": true
    }
  },
  "derived": {
