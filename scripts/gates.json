{
  "_about": "Every gate a command can require, named by what it means. DECISIONS ('gates') are Paul's, set only by scripts/approve.py through his /approve; 'met' means Approved or Approved with Conditions and the files recorded with THAT approval are unchanged (an edit voids only that decision; later ones are flagged 'upstream change'). CONDITIONS are facts the scripts check themselves and log in log.md the first time they are met; nobody approves them. Each decision names its artifact (the status.json mark listing the files the approval covers) and its producer (the command that writes them). R3 (Paul, 2026-10-08): two approvals for discovery + audit. Approval 1 = entity_approved + proof_sheet_approved in one /approve line ('with' names the decision approved in the same line); Approval 2 = audit_approved + brand_guide_approved. discovery_signed_off and blockers_cleared are conditions. page_specs_approved is a global condition Paul meets once with /approve global specs.",
  "gates": {
    "entity_approved": {
      "label": "Discovery approved — the Decision Sheet (every identity and format decision) and the entity foundation (category, area, variants, reserved homepage variant)",
      "plain": "the Decision Sheet and the entity foundation",
      "requires": [
        "client_setup"
      ],
      "artifact": "entity_record",
      "producer": "/discovery {slug} discovery",
      "producer_blog_only": "/blog {slug} intake"
    },
    "proof_sheet_approved": {
      "label": "Client facts approved — the proof sheet ready for Paul to send, or the client's answers taken directly",
      "plain": "the client proof sheet (or the client's direct answers)",
      "requires": [
        "entity_approved"
      ],
      "artifact": "proof_sheet",
      "producer": "/discovery {slug} proof-sheet",
      "with": "entity_approved"
    },
    "audit_approved": {
      "label": "Audit deliverables approved (Finding Register, URL Decision Map, Recommendations, Evidence Manifest)",
      "plain": "the audit deliverables",
      "requires": [
        "entity_approved",
        "audit_steps_complete"
      ],
      "artifact": "audit_deliverables",
      "producer": "/discovery {slug} audit"
    },
    "brand_guide_approved": {
      "label": "Brand Guide approved: the client's returned proof sheet reconciled (verified facts separated from unsupported claims)",
      "plain": "the reconciled Brand Guide",
      "requires": [
        "proof_sheet_returned"
      ],
      "artifact": "reconciled",
      "producer": "/discovery {slug} reconcile",
      "with": "audit_approved"
    },
    "link_wheel_approved": {
      "label": "Link wheel built and verified — schema may start",
      "plain": "the link wheel (built and verified)",
      "requires": [
        "pages_built"
      ],
      "artifact": "link_wheel",
      "producer": "/finish {slug} wheel"
    },
    "release_approved": {
      "label": "Schema built and QA cleared — release",
      "plain": "release (schema built, QA cleared)",
      "requires": [
        "link_wheel_approved",
        "blockers_cleared"
      ],
      "artifact": "release_qa",
      "producer": "/finish {slug} qa",
      "before": {
        "mark": "schema_built",
        "producer": "/finish {slug} schema"
      }
    },
    "blog_map_approved": {
      "label": "Blog Decision Map approved — redirects and blog briefs may start",
      "plain": "the Blog Decision Map",
      "requires": [
        "release_approved"
      ],
      "requires_blog_only": [
        "entity_approved",
        "blog_topics_approved"
      ],
      "artifact": "blog_map",
      "producer": "/blog {slug} map"
    },
    "blog_topics_approved": {
      "label": "Blog Authority Builder topic list approved (checked against service and location page FAQs)",
      "plain": "the blog topic list",
      "requires": [
        "entity_approved"
      ],
      "artifact": "topics",
      "producer": "/blog {slug} topics"
    },
    "wordpress_pilot_approved": {
      "label": "WordPress pilot passed for this site — the system may write titles, keyword, social, robots, canonical and schema directly",
      "plain": "the WordPress pilot for this site",
      "requires": [
        "wordpress_connected"
      ],
      "artifact": "wordpress_pilot",
      "producer": "/wp-check {slug} --pilot"
    }
  },
  "conditions": {
    "client_setup": {
      "label": "Client set up (/new-client finished)",
      "plain": "the client has been set up with /new-client",
      "producer": "/new-client"
    },
    "proof_sheet_returned": {
