  "_steps_about": "Every command step: the gates run.py start checks (looked up here \u2014 nowhere else), what it must produce before run.py finish will close it, and (reads) the only files the agent reads for that step (run.py start prints them). {batch} and {page} come from --batch / --page; {prev_post} is the newest blog post. produces: an artifact name (a status.py mark recorded during the run), 'steps:S01,S02' (an outcome for each audit step), 'batch:{batch}:<stage>' (the batch files recorded), 'blog_post' (a new post registered with its file), 'batch_state:{batch}:a|b' (the batch reached one of those states).",
  "artifacts": {
    "entity_record": "the Discovery Record with the entity foundation (Brand Guide A/B proposal)",
    "proof_sheet": "the client proof sheet (.md; the Google Doc client copy is separate)",
    "proof_sheet_returned": "the client's returned proof sheet, saved as given",
    "audit_deliverables": "the Finding Register, URL Decision Map, Recommendations and Evidence Manifest",
    "reconciled": "the reconciled Brand Guide (clients/<slug>/brand-guide.md)",
    "discovery_summary": "the Discovery Summary with the client-confirmation list",
    "blocker_checklist": "the Technical Blocker Checklist",
    "site_plan": "the site plan (.md, registered with status.py plan)",
    "link_wheel": "the Link Wheel Tables and the wheel verification",
    "schema_built": "the validated schema files",
    "release_qa": "the QA Punch-List and acceptance sheets",
    "blog_map": "the Blog Decision Map",
    "topics": "the Blog Topic List",
    "wordpress_pilot": "the WordPress pilot report (/wp-check --pilot)",
    "story_round": "the stories interview round (questions for the owner)",
    "story_bank": "the updated story bank (clients/<slug>/interviews/story-bank.md)",
    "voice_dna": "the author's Voice DNA file (clients/<slug>/interviews/voice-dna-<author>.md)"
  },
  "steps": {
    "new-client": {
