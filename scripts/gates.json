      ]
    },
    "structural_changes_allowed": {
      "label": "Structural changes allowed (entity + Brand Guide approved): redirects, URL/slug changes, consolidations, SEO titles and H1s",
      "plain": "the entity foundation and the reconciled Brand Guide (structural changes)",
      "requires": [
        "entity_approved",
        "brand_guide_approved"
      ]
    }
  },
