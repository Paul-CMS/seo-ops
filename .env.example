# Copy this file to .env and fill in real values. Never commit .env.

# --- DataforSEO API ---
# From app.dataforseo.com -> API Access (use the API password, not the dashboard password)
DFS_LOGIN=
DFS_PASSWORD=

# --- WordPress sites (one block per client) ---
# Replace CLIENT with a short uppercase name, e.g. WP_ACME_URL.
# Password: wp-admin -> Users -> Profile -> Application Passwords.
# Use a dedicated "seo-ops" user with the Editor role.
WP_CLIENT_URL=https://example.com
WP_CLIENT_USER=
WP_CLIENT_APP_PASSWORD=
