# Copy this file to .env and fill in real values. Never commit .env.

# --- DataforSEO API ---
# From app.dataforseo.com -> API Access (use the API password, not the dashboard password)
DFS_LOGIN=
DFS_PASSWORD=

# --- WordPress sites (one block per client) ---
# One block per client. <SLUG> = the client slug in capitals, hyphens as underscores:
# red-rover-roofing -> WP_RED_ROVER_ROOFING_URL. Setup: wordpress/wordpress-site-setup.md.
# `python3 scripts/wp.py env-lines <slug>` prints the exact three lines for a client.
# _USER = the USERNAME of the dedicated "seo-ops" WordPress user, role Editor (never Administrator).
# _APP_PASSWORD = the Application Password (wp-admin -> Users -> seo-ops -> Application Passwords):
#   24 characters in six groups of four, keep the spaces. NOT the normal login password.
#   WordPress asks for a name when you create it — type seo-ops; that name does not go in this file.
WP_<SLUG>_URL=https://example.com
WP_<SLUG>_USER=
WP_<SLUG>_APP_PASSWORD=
