# Copy this file to .env and fill in real values. Never commit .env.

# --- DataforSEO API ---
# From app.dataforseo.com -> API Access (use the API password, not the dashboard password)
DFS_LOGIN=
DFS_PASSWORD=

# --- WordPress sites (one block per client) ---
# One block per client. <SLUG> = the client slug in capitals, hyphens as underscores:
# red-rover-roofing -> WP_RED_ROVER_ROOFING_URL. Setup: wordpress/wordpress-site-setup.md.
# Password: wp-admin -> Users -> Profile -> Application Passwords.
# A dedicated "seo-ops" user with the Editor role (never Administrator).
WP_<SLUG>_URL=https://example.com
WP_<SLUG>_USER=
WP_<SLUG>_APP_PASSWORD=
